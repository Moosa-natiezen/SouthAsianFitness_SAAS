# ═══════════════════════════════════════════════════════════════════════
# South Asian Fitness API — Environment Variables (Render Deployment)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values for production.
# Do NOT commit .env to version control.

# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_secure_random_string_at_least_32_chars
CSRF_SECRET_KEY=generate_a_separate_secure_random_string_at_least_32_chars

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://southasianfitness.com,https://www.southasianfitness.com

# ── Lemon Squeezy (Billing) ──────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=

# ── Frontend URL (for checkout redirects) ─────────────────────────────
FRONTEND_URL=https://southasianfitness.com

# ── n8n (internal founder alerts) ─────────────────────────────────────
# Optional. If set, validated Lemon Squeezy webhook events are forwarded
# here for internal alerts/workflows. Failures are logged and never block
# the webhook response.
N8N_WEBHOOK_URL=

# ── WhatsApp Cloud API (chat-based meal logging) ────────────────────
# Verify token: any string you choose; must match what you enter in the
# Meta App Dashboard when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=
# Permanent token from a Meta system user with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the business number that sends replies.
WHATSAPP_PHONE_NUMBER_ID=
# App secret (Meta App Dashboard → Settings → Basic) — verifies inbound
# webhook HMAC signatures. Required in production.
WHATSAPP_APP_SECRET=

# ── Vapi.ai (voice AI nutritionist) ─────────────────────────────────
# Secret for authenticating inbound Vapi tool-calls webhooks. Set the same
# value in the Vapi dashboard (Assistant → Server Messages → Server Secret)
# and send it as the x-vapi-secret header. Required in production.
VAPI_SERVER_SECRET=

# ── Sentry Error Tracking ─────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Cookie Settings ───────────────────────────────────────────────────
SECURE_COOKIES=true
CSRF_COOKIE_SAMESITE=none
