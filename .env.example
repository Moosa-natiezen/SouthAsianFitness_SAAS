# Application
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=safitness
POSTGRES_PASSWORD=changeme
POSTGRES_DB=safitness
POSTGRES_PORT=5432

# Backend running on the host machine (not inside Docker)
DATABASE_URL=postgresql+psycopg://safitness:changeme@localhost:5432/safitness

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend (copy NEXT_PUBLIC_API_URL into frontend/.env.local as well)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
