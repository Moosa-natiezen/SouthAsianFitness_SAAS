# South Asian Fitness Dashboard — Environment Variables (Vercel)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values for production.
# Do NOT commit .env.local to version control.

# ── Backend API URL ───────────────────────────────────────────────────
# The full URL of the deployed Render backend (no trailing slash).
NEXT_PUBLIC_API_URL=https://your-render-app.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
