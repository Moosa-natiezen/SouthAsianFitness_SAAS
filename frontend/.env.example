[TEMPLATE]
# ═══════════════════════════════════════════════════════════════════════
# South Asian Fitness Dashboard — Environment Variables (Vercel)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values for production.
# Do NOT commit .env.local to version control.

# ── Backend API URL ───────────────────────────────────────────────────
# Leave UNSET in production — Vercel rewrites /api/* to the Render backend
# automatically (see vercel.json). Only set this for local development:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=

# ── Site URL (used for sitemap, metadata, OAuth callbacks) ────────────
NEXT_PUBLIC_SITE_URL=https://southasianfitness.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ── PostHog Analytics ─────────────────────────────────────────────────
# Get your key from https://app.posthog.com/project/keys
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry Error Tracking ─────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
